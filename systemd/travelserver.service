[Unit]
Description=TravelServer photo backup daemon
After=local-fs.target usbmuxd.service
Wants=usbmuxd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/travelserver/travelserver/main.py --config /etc/travelserver/travelserver.conf run
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
