# Common settings for webapps/ compose examples. Copy to .env and edit.
# Find the real mountpoint of each mirror with: lsblk -o NAME,LABEL,MOUNTPOINT

# --- Immich ---
IMMICH_VERSION=release
DB_USERNAME=postgres
DB_PASSWORD=change-me-long-random
DB_DATABASE_NAME=immich
# Local disk (NOT the backup SSDs) for Immich's own uploads and database:
UPLOAD_LOCATION=/srv/immich/library
DB_DATA_LOCATION=/srv/immich/postgres

# --- Both examples ---
# Where travelserver has TRAVEL1/TRAVEL2 mounted, e.g. /mnt/travelserver/sda1
TRAVEL1_BACKUP=/mnt/travelserver/sda1/BACKUP
TRAVEL2_BACKUP=/mnt/travelserver/sdb1/BACKUP
